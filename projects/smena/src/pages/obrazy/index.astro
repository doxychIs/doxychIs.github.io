---
import { withBase } from '../../lib/urls';
import Layout from '../../layouts/Layout.astro';
import LookCard from '../../components/LookCard.astro';
import { looks } from '../../data/catalog';
---
<Layout title="Коллекция образов" description="Графичное каре, естественная текстура и выразительная медь. Коллекция СМЕНЫ — отправная точка для вашего собственного образа.">
  <div class="page-intro page-pad"><span class="eyebrow">СМЕНА / Коллекция</span><h1>НАЙДИТЕ СВОЮ<br /><span>ТОЧКУ ЗРЕНИЯ.</span></h1><p>Это не каталог одинаковых стрижек. Это три направления, от которых можно оттолкнуться. Остальное решим вместе.</p></div>
  <section class="page-pad collection-page" aria-label="Образы коллекции"><div class="looks-grid">{looks.map(look=><LookCard look={look} />)}</div><div class="collection-note"><span aria-hidden="true">↗</span><p>Можно прийти с референсом. Можно — с ощущением. Мы поможем превратить и то и другое в понятную форму.</p><a class="text-link" href={withBase("/visit/")}>Начать со стрижки</a></div></section>
</Layout>
