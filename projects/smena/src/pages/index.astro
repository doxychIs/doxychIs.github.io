---
import { withBase, withSrcset } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import LookCard from '../components/LookCard.astro';
import Questions from '../components/Questions.astro';
import { looks, money, duration, visitTotal } from '../data/catalog';
import { directions, visitSteps } from '../data/home';
const example = visitTotal('cut', ['care']);
---
<Layout>
  <section class="campaign" aria-labelledby="campaign-title">
    <div class="campaign-label"><span>Студия волос / Пермь</span><span>Форма. Цвет. Характер.</span></div>
    <h1 id="campaign-title" class="campaign-title">ВЫ — <span>НОВАЯ</span><br />ТОЧКА ОТСЧЁТА.</h1>
    <div class="campaign-visual"><img src={withBase('/images/collection.jpg')} srcset={withSrcset('/images/collection-small.jpg 900w, /images/collection.jpg 1536w')} sizes="100vw" width="1536" height="1024" alt="Три образа СМЕНЫ: графичное каре, живая текстура и медный цвет" fetchpriority="high" decoding="async" /><span class="campaign-sticker">Свой<br />характер.<small>Без чужих правил.</small></span></div>
    <div class="campaign-bottom"><p>Стрижки, цвет и уход с вниманием к вам.<br />Находим образ, с которым хорошо каждый день.</p><div class="campaign-actions"><a class="button button-dark" href="#services">Выбрать услугу</a><a class="text-link" href={withBase('/obrazy/')}>Найти идею для образа</a></div></div>
    <nav class="home-navigation" aria-label="На этой странице"><span>Знакомство со СМЕНОЙ</span><a href="#services">Услуги и цены</a><a href="#collection">Образы</a><a href="#first-visit">Первый визит</a><a href="#questions">Вопросы</a></nav>
  </section>

  <section id="services" class="home-services page-pad" aria-labelledby="services-title">
    <div class="section-head"><div><span class="eyebrow">/01 — Выберите направление</span><h2 id="services-title">ЧТО ХОЧЕТСЯ<br /><span>ИЗМЕНИТЬ?</span></h2></div><div class="section-caption"><p>Новая форма, любимый оттенок или время для ухода. Начните с того, что нужно сейчас.</p><a class="text-link" href={withBase('/menu/')}>Все услуги и цены</a></div></div>
    <div class="direction-grid">{directions.map((direction,i)=><a class="direction-card" href={withBase(`/menu/#${direction.anchor}`)} aria-labelledby={`direction-${direction.id}`}>
      <div class="direction-image"><img src={withBase(`/images/${direction.image}.webp`)} srcset={withSrcset(direction.image==='texture'?'/images/texture-small.webp 320w, /images/texture.webp 512w':`/images/${direction.image}-small.webp 480w, /images/${direction.image}.webp 960w`)} sizes="(max-width: 650px) 90vw, (max-width: 1100px) 45vw, 24vw" width={direction.image==='texture'?512:960} height={direction.image==='texture'?1024:1200} alt={direction.alt} loading="lazy" decoding="async" /><span class="direction-number">0{i+1} / {direction.word}</span></div>
      <div class="direction-title"><h3 id={`direction-${direction.id}`}>{direction.title}</h3><span>{direction.time}</span></div><p>{direction.description}</p><span class="direction-includes">{direction.includes}</span><div class="direction-bottom"><strong>{direction.priceLabel} {money(direction.price)}</strong><span class="direction-action">{direction.action}</span></div>
    </a>)}</div>
    <p class="services-note">В стоимость стрижки включены мытьё и укладка. Для окрашивания точную цену согласуем после консультации.</p>
  </section>

  <section class="manifesto page-pad" aria-labelledby="manifesto-title"><span class="eyebrow">/02 — Наш подход</span><div><h2 id="manifesto-title">НЕ ПЕРЕДЕЛЫВАЕМ.<br /><span>ПРОЯВЛЯЕМ.</span></h2><div class="manifesto-copy"><p>У хорошего образа есть характер. Ваш. Поэтому сначала слушаем: как вы живёте, что любите в своих волосах и сколько времени готовы тратить на укладку.</p><p>А потом работаем с формой, текстурой и цветом. Так, чтобы результат был вашим и после первого мытья головы.</p><a class="text-link" href={withBase('/studio/')}>Больше о студии и подходе</a></div></div></section>

  <section id="collection" class="collection page-pad" aria-labelledby="collection-title"><div class="section-head"><div><span class="eyebrow">/03 — Идеи для вашей СМЕНЫ</span><h2 id="collection-title">ТРИ НАСТРОЕНИЯ.<br />НИ ОДНОГО ПРАВИЛА.</h2></div><div class="section-caption"><p>Посмотрите, как живёт форма, чем укладывать волосы и когда обновлять образ.</p><a class="text-link" href={withBase('/obrazy/')}>Вся коллекция</a></div></div><div class="looks-grid">{looks.map(look=><LookCard look={look} />)}</div></section>

  <section id="first-visit" class="first-visit page-pad" aria-labelledby="first-visit-title"><div class="first-visit-heading"><span class="eyebrow">/04 — Первый визит</span><h2 id="first-visit-title">БЕЗ СЮРПРИЗОВ.<br /><span>КРОМЕ ПРИЯТНЫХ.</span></h2><p>Не нужно разбираться в техниках и названиях. Достаточно знать, как хочется себя чувствовать.</p></div><ol class="visit-steps">{visitSteps.map((step,i)=><li><span class="step-index" aria-hidden="true">0{i+1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>

  <section class="visit-invitation page-pad" aria-labelledby="invitation-title"><span class="eyebrow">/05 — Понятный план</span><div><h2 id="invitation-title">ВАШ ВИЗИТ.<br />ВАША КОМБИНАЦИЯ.</h2><p>Выберите основную услугу, добавьте уход и сразу увидите ориентир по цене и времени.</p><a class="button button-light" href={withBase('/visit/')}>Составить план визита</a><p class="invitation-note">План остаётся у вас. Дату и время подтвердите со студией отдельно.</p></div><div class="ticket-preview" aria-hidden="true"><span>СМЕНА / ПРИМЕР ВИЗИТА</span><strong>СТРИЖКА<br />+ УХОД</strong><div>{example.items.map(item=><div>{item.name} · {duration(item.minutes)}</div>)}</div><span class="ticket-line"></span><div class="preview-total"><b>{money(example.price)}</b><span>{duration(example.minutes)}</span></div></div></section>

  <section id="questions" class="home-questions page-pad" aria-labelledby="questions-title"><div><span class="eyebrow">/06 — До встречи</span><h2 id="questions-title">ХОРОШИЕ<br />ВОПРОСЫ.</h2><p>Собрали то, что помогает определиться перед первым визитом.</p><a class="text-link" href={withBase('/menu/')}>Вернуться к выбору услуг</a></div><Questions /></section>
</Layout>
