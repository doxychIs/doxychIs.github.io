---
import { withBase } from '../../lib/urls';
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import { journeys, money, duration } from '../../data/care';
export function getStaticPaths(){return journeys.map(journey=>({params:{id:journey.id},props:{journey}}));}
const {journey}=Astro.props;
---
<Layout title={journey.title} description={journey.intro} image={`/images/${journey.image==='room-detail'?'room':journey.image}.jpg`}><div class="journey-heading section-pad"><a class="quiet-link" href={withBase("/uhod/")}>← Все маршруты</a><span class="eyebrow">{journey.subtitle}</span><h1>{journey.title}</h1><p>{journey.intro}</p><div class="journey-tags"><span>{duration(journey.minutes)}</span><span>{money(journey.price)}</span><span>В вашем темпе</span></div><a class="button button-plum" href={withBase(`/visit/?route=${journey.id}`)}>Выбрать этот маршрут <span aria-hidden="true">→</span></a></div><figure class="journey-photo"><img src={withBase(`/images/${journey.image}.jpg`)} width="1536" height="1024" alt={journey.alt} loading="lazy" /><figcaption>{journey.id==='face'||journey.id==='slow'?'Внимание к каждому прикосновению.':'Свет, тепло и немного тишины.'}</figcaption></figure><section class="journey-timeline section-pad" aria-labelledby="timeline-title"><div><span class="eyebrow">Шаг за шагом</span><h2 id="timeline-title">У времени<br /><em>есть свой ритм.</em></h2><p>Этапы плавно переходят друг в друга. Весь маршрут занимает {duration(journey.minutes)}.</p><Mark /></div><ol>{journey.steps.map((step,i)=><li><span class="timeline-dot">0{i+1}</span><div><span class="eyebrow">{step.minutes} минут</span><h3>{step.name}</h3><p>{step.text}</p></div></li>)}</ol></section><section class="after-care section-pad"><span class="eyebrow">И после ухода</span><h2>Возвращайтесь<br /><em>не спеша.</em></h2><p>{journey.after}</p><a class="button button-outline" href={withBase(`/visit/?route=${journey.id}`)}>Оставить время для себя <span aria-hidden="true">→</span></a></section></Layout>
