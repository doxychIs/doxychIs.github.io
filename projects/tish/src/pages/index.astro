---
import { withBase, withSrcset } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import Breathing from '../components/Breathing.astro';
import Mark from '../components/Mark.astro';
import { journeys, money, duration } from '../data/care';
---
<Layout><section class="immersive-hero" aria-labelledby="hero-title"><img src={withBase("/images/room.jpg")} srcset={withSrcset("/images/room-small.jpg 900w, /images/room.jpg 1536w")} sizes="100vw" width="1536" height="1024" alt="Тихая комната ухода: тёплый свет, льняная кушетка и керамика" fetchpriority="high" decoding="async" /><div class="hero-shade"></div><div class="hero-copy"><span class="eyebrow">Пермь · пространство бережного ухода</span><h1 id="hero-title">Поближе<br />к себе.</h1><p>Через мягкое прикосновение,<br />спокойный свет и время без спешки.</p><a class="button button-hero" href={withBase("/uhod/")}>Найти свой маршрут <span aria-hidden="true">→</span></a></div><div class="hero-foot"><span>Лицо / тело / руки</span><a href="#welcome" aria-label="Узнать больше о ТИШИ">Не спешите. Листайте. <span aria-hidden="true">↓</span></a></div></section>
  <section id="welcome" class="welcome section-pad"><Mark /><span class="eyebrow">Красота начинается с внимания</span><h2>Можно прийти<br />не за переменами.<br /><em>А за ощущением себя.</em></h2><p>В ТИШИ мы оставляем место простым вещам: тёплому полотенцу, удобному креслу, бережному уходу. Здесь не нужно становиться другой. Можно просто побыть собой.</p></section>
  <section class="routes-home section-pad" aria-labelledby="routes-title"><div class="routes-heading"><span class="eyebrow">Не список процедур. Ваше время.</span><h2 id="routes-title">У каждого дня —<br /><em>свой маршрут.</em></h2><p>Выберите, о чём хочется позаботиться сейчас.</p></div><div class="route-list">{journeys.slice(0,3).map((j,i)=><a class="route-row" href={withBase(`/uhod/${j.id}/`)}><span class="route-number">0{i+1}</span><div><span class="route-label">{j.label}</span><h3>{j.title}</h3><p>{j.subtitle}</p></div><div class="route-price"><span>{duration(j.minutes)}</span><strong>{money(j.price)}</strong></div><span class="route-arrow" aria-hidden="true">↗</span></a>)}<a class="route-long" href={withBase("/uhod/slow/")}><span>Для дня, который хочется оставить себе</span><strong>Дольше для себя <span aria-hidden="true">→</span></strong><span>2 часа · лицо и тело · {money(7900)}</span></a></div></section>
  <section class="touch-story"><div class="touch-photo"><img src={withBase("/images/touch.jpg")} srcset={withSrcset("/images/touch-small.jpg 900w, /images/touch.jpg 1536w")} sizes="(max-width:750px) 100vw, 55vw" width="1536" height="1024" loading="lazy" alt="Мягкое прикосновение во время ухода за лицом" /></div><div class="touch-copy"><span class="eyebrow">Небольшие вещи, которые меняют ощущение</span><h2>Мягко.<br />Бережно.<br /><em>По-настоящему.</em></h2><p>Спрашиваем о комфортном давлении. Подбираем текстуры. Не торопим после ухода. И понимаем, когда лучше оставить вас в тишине.</p><a class="quiet-link" href={withBase("/space/")}>Как устроено пространство <span aria-hidden="true">→</span></a></div></section>
  <Breathing />
  <section class="first-visit section-pad"><span class="eyebrow">Если вы у нас впервые</span><h2>Всё начинается<br /><em>с простого шага.</em></h2><div class="first-steps"><div><span>01</span><h3>Выберите маршрут</h3><p>По тому, что хочется почувствовать. Можно начать с одного ухода.</p></div><div><span>02</span><h3>Оставьте немного воздуха</h3><p>Не планируйте следующую встречу вплотную. Пусть после ухода останется время.</p></div><div><span>03</span><h3>Расскажите о себе</h3><p>Предпочтения, чувствительность к ароматам, комфортный темп — всё имеет значение.</p></div></div><a class="button button-plum" href={withBase("/visit/")}>Спланировать первый визит <span aria-hidden="true">→</span></a></section></Layout>
